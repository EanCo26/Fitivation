<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.exercise.current.CurrentExerciseFragment">

    <TextView
        android:id="@+id/current_exercise_name"
        style="@style/title"
        android:textAlignment="textStart"
        tools:text="@string/name_exercise"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/current_exercise_goal"
        style="@style/sub_title"
        android:textAlignment="textStart"
        tools:text="@string/goal_exercise"
        app:layout_constraintTop_toBottomOf="@id/current_exercise_name"/>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/current_exercise_progress"
        style="@style/progress"
        tools:progress="2"
        android:layout_width="@dimen/indicator_edit_text_width"
        app:layout_constraintTop_toBottomOf="@id/current_exercise_goal"
        app:layout_constraintBottom_toTopOf="@id/current_exercise_action"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/current_exercise_edit"
        style="@style/fragment_actions"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/current_exercise_progress"
        app:layout_constraintEnd_toEndOf="@id/current_exercise_progress"
        app:layout_constraintTop_toTopOf="@id/current_exercise_progress"
        app:layout_constraintBottom_toBottomOf="@id/current_exercise_progress">
    
        <EditText
            android:id="@+id/current_exercise_edit_text"
            style="@style/edit_text"
            android:hint="0..." />

        <TextView
            android:id="@+id/current_exercise_edit_unit"
            style="@style/view_component"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="exercise_unit"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/current_exercise_action"
        style="@style/fragment_actions"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/current_exercise_action_previous"
            android:enabled="false"
            style="@style/double_arrow_button_left"/>

        <Button
            android:id="@+id/current_exercise_action_finish"
            style="@style/button"
            android:text="@string/finish_exercise" />

        <ImageButton
            android:id="@+id/current_exercise_action_next"
            android:enabled="false"
            style="@style/double_arrow_button_right" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>