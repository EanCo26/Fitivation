<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/fragment"
    tools:context=".ui.exercise.ExerciseFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/exercise_rc"
        style="@style/fragment_recycler_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/exercise_action"
        tools:listitem="@layout/fragment_exercise_item" />

    <LinearLayout
        android:id="@+id/exercise_action"
        style="@style/fragment_actions"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/exercise_action_start"
            style="@style/button"
            android:text="@string/start_exercises" />

        <!--        TODO - Remove button in favor of minus/remove button on indivadual items (in place of radio button)? -->
        <Button
            android:id="@+id/exercise_action_remove"
            style="@style/button"
            android:backgroundTint="@color/lightRed"
            android:text="@string/delete_exercises" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>