<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Fitivation" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/fitivationPrimary</item>
        <item name="colorPrimaryVariant">@color/fitivationPrimaryVariant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/fitivationSecondary</item>
        <item name="colorSecondaryVariant">@color/fitivationSecondaryVariant</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <!-- Customize your theme here. -->
    </style>

    <color name="fitivationPrimary">@color/blue</color>
    <color name="fitivationPrimaryVariant">@color/cornflowerBlue</color>
    <color name="fitivationSecondary">@color/lightRed</color>
    <color name="fitivationSecondaryVariant">@color/lighterRed</color>
    <color name="fitivationMisc">@color/lightGray</color>

    <style name="list_item_action_edit" parent="list_item_action_button">
        <item name="android:src">@drawable/edit_white_24dp</item>
    </style>

    <style name="list_item_action_delete" parent="list_item_action_button">
        <item name="android:src">@drawable/delete_white_24dp</item>
    </style>
</resources>